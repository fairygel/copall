{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": false,
        "outDir": "dist-electron",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "include": ["main.ts", "preload.ts"]
}
