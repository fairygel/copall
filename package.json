{
    "name": "copall",
    "private": true,
    "version": "0.2.2",
    "type": "module",
    "main": "dist-electron/main/main.js",
    "scripts": {
        "dev": "electron-vite dev --noSandbox",
        "build": "tsc && electron-vite build",
        "preview": "electron-vite preview --noSandbox",
        "dist": "electron-builder --config electron/builder.json",
        "dist-linux": "electron-builder --config electron/builder.json --linux",
        "catalog:sync": "tsx scripts/sync-catalog.ts",
        "version:bump": "node scripts/bump-version.mjs"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "dotenv": "^17.4.2",
        "js-tiktoken": "^1.0.21",
        "jsdom": "^30.1.0",
        "lucide-react": "^1.23.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0"
    },
    "devDependencies": {
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.7.0",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.9",
        "electron-vite": "^5.0.0",
        "tsx": "^4.23.12",
        "typescript": "~5.8.3",
        "vite": "^7.3.6"
    },
    "description": "Copall — AI chat app",
    "author": "fairygel"
}
